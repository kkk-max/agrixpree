# Backend EC2 public URL (no trailing slash)
# e.g. http://13.232.xx.xx:4000  OR  https://api.agrixpree.com
VITE_API_URL=http://YOUR_BACKEND_EC2_IP:4000

# OneSignal Web Push App ID — public identifier, safe to expose client-side
VITE_ONESIGNAL_APP_ID=0b6bc8e4-96e7-433c-865b-1e74c0ebf9e4

# OneSignal Safari Web ID (Settings > Platforms > Web Push, "Safari" section) — public, safe to expose
VITE_ONESIGNAL_SAFARI_WEB_ID=web.onesignal.auto.4715199e-f86d-44ca-99ff-a9854a17e932
